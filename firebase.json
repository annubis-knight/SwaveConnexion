{
  "hosting": {
    "site": "swaveconnection",
    "public": ".output/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "comment_routing": "Site 100% pre-genere (nuxt generate) : PAS de catch-all SPA. Les URL inconnues renvoient 404.html avec un vrai HTTP 404 (evite les soft 404 sur le spam herite du domaine). trailingSlash:false aligne les URL sur la canonical sans slash. NE PAS activer cleanUrls (casserait /google6e98290a3fd5b817.html, verif GSC).",
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(woff2|woff|ttf|otf)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|gif|webp|avif|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, stale-while-revalidate=604800"
          }
        ]
      }
    ]
  }
}
